<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- VIEW 1: OVERVIEW / STATISTICS (Dark Green) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/widget_bg_dark"
            android:padding="12dp">
            
            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_leaf" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="5dp"
                    android:text="RecycleScan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_more" />
            </LinearLayout>
            
            <!-- Middle Body -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp">
                
                <!-- Circular 86% Badge -->
                <FrameLayout
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/widget_circle_progress_dark">
                    <TextView
                        android:id="@+id/tv_recyclable_percentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="86%"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                </FrameLayout>
                
                <!-- Content & 4 Stats -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="10dp"
                    android:orientation="vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Great job! 🍃"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                        
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="You've recycled "
                            android:textSize="11sp"
                            android:textColor="#C8E6C9" />
                        <TextView
                            android:id="@+id/tv_items_this_week"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12 items"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#86EFAC" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" this week."
                            android:textSize="11sp"
                            android:textColor="#C8E6C9" />
                    </LinearLayout>
                    
                    <!-- 4 Category Cards Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="5dp">
                        
                        <!-- Plastic -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:background="@drawable/widget_category_card_dark"
                            android:padding="4dp"
                            android:gravity="center"
                            android:layout_marginRight="3dp">
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_widget_bottle" />
                            <TextView
                                android:id="@+id/tv_count_plastic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="3dp"
                                android:text="5"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>
                        
                        <!-- Paper -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:background="@drawable/widget_category_card_dark"
                            android:padding="4dp"
                            android:gravity="center"
                            android:layout_marginRight="3dp">
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_widget_paper" />
                            <TextView
                                android:id="@+id/tv_count_paper"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="3dp"
                                android:text="3"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>
                        
                        <!-- Glass -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:background="@drawable/widget_category_card_dark"
                            android:padding="4dp"
                            android:gravity="center"
                            android:layout_marginRight="3dp">
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_widget_glass" />
                            <TextView
                                android:id="@+id/tv_count_glass"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="3dp"
                                android:text="2"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>
                        
                        <!-- Metal -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:background="@drawable/widget_category_card_dark"
                            android:padding="4dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_widget_can" />
                            <TextView
                                android:id="@+id/tv_count_metal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="3dp"
                                android:text="2"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Navigation Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:orientation="horizontal"
                android:background="@drawable/widget_nav_bar_dark"
                android:gravity="center_vertical"
                android:paddingLeft="4dp"
                android:paddingRight="4dp">
                
                <LinearLayout
                    android:id="@+id/btn_prev_0"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&lt;"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>
                
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="1 / 3"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="11sp" />
                
                <LinearLayout
                    android:id="@+id/btn_next_0"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- VIEW 2: ECO TIP (Light) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/widget_bg_light"
            android:padding="12dp">
            
            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_leaf" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="5dp"
                    android:text="RecycleScan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937" />
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_more_dark" />
            </LinearLayout>
            
            <!-- Middle Body: Globe on Left + Tip on Right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp">
                
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_widget_globe" />
                    
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="10dp"
                    android:orientation="vertical">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Eco Tip 🍃"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937" />
                        
                    <TextView
                        android:id="@+id/tv_eco_tip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Small changes today create a cleaner, greener tomorrow. Thank you for caring!"
                        android:textSize="11sp"
                        android:textColor="#4B5563"
                        android:maxLines="3"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Navigation Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:orientation="horizontal"
                android:background="@drawable/widget_nav_bar_light"
                android:gravity="center_vertical"
                android:paddingLeft="4dp"
                android:paddingRight="4dp">
                
                <LinearLayout
                    android:id="@+id/btn_prev_1"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&lt;"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>
                
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="2 / 3"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="11sp" />
                
                <LinearLayout
                    android:id="@+id/btn_next_1"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        
        <!-- VIEW 3: RECENT SCANS (Light) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/widget_bg_light"
            android:padding="12dp">
            
            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_leaf" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="5dp"
                    android:text="RecycleScan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937" />
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_widget_more_dark" />
            </LinearLayout>
            
            <!-- Subhead Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Scans"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937" />
                <LinearLayout
                    android:id="@+id/btn_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View all &gt;"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#0F6B3A" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3 Recent Scan Rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">
                
                <!-- Row 1 -->
                <LinearLayout
                    android:id="@+id/view_recent_scan_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_widget_can" />
                    <TextView
                        android:id="@+id/tv_recent_0_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="6dp"
                        android:text="Aluminum Can"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/tv_recent_0_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="6dp"
                        android:text="20 May, 10:30 AM"
                        android:textSize="9sp"
                        android:textColor="#6B7280" />
                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_widget_check" />
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:id="@+id/view_recent_scan_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_widget_glass" />
                    <TextView
                        android:id="@+id/tv_recent_1_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="6dp"
                        android:text="Glass Bottle"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/tv_recent_1_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="6dp"
                        android:text="19 May, 03:45 PM"
                        android:textSize="9sp"
                        android:textColor="#6B7280" />
                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_widget_check" />
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout
                    android:id="@+id/view_recent_scan_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_widget_bottle" />
                    <TextView
                        android:id="@+id/tv_recent_2_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginLeft="6dp"
                        android:text="Milk Carton"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:maxLines="1"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/tv_recent_2_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="6dp"
                        android:text="18 May, 11:20 AM"
                        android:textSize="9sp"
                        android:textColor="#6B7280" />
                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_widget_check" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Navigation Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:orientation="horizontal"
                android:background="@drawable/widget_nav_bar_light"
                android:gravity="center_vertical"
                android:paddingLeft="4dp"
                android:paddingRight="4dp">
                
                <LinearLayout
                    android:id="@+id/btn_prev_2"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&lt;"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>
                
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="3 / 3"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="11sp" />
                
                <LinearLayout
                    android:id="@+id/btn_next_2"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </ViewFlipper>
</FrameLayout>
