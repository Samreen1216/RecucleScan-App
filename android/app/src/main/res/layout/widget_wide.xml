<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ViewFlipper
        android:id="@+id/view_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- VIEW 0: OVERVIEW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/widget_bg_round"
            android:padding="16dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RecycleScan"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#1B5E20" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● ○ ○"
                    android:textSize="12sp"
                    android:textColor="#2E7D32" />
            </LinearLayout>
            
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/widget_card_bg"
                    android:padding="12dp"
                    android:layout_marginRight="8dp">
                    <TextView
                        android:id="@+id/tv_total_items"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#1B5E20" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scanned"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#2E7D32" />
                </LinearLayout>
                
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/widget_card_bg"
                    android:padding="12dp"
                    android:layout_marginLeft="8dp">
                    <TextView
                        android:id="@+id/tv_recyclable_percentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-%"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#1B5E20" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recycled"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#2E7D32" />
                </LinearLayout>
            </LinearLayout>
            
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <LinearLayout
                    android:id="@+id/btn_prev_0"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/widget_nav_button"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&lt;" android:textColor="#1B5E20" android:textStyle="bold" android:textSize="16sp" />
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/btn_scan"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/widget_button_primary"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SCAN ITEM" android:textColor="#FFFFFF" android:fontFamily="sans-serif-black" android:textSize="14sp" />
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/btn_history"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/widget_button_secondary"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HISTORY" android:textColor="#1B5E20" android:fontFamily="sans-serif-black" android:textSize="12sp" />
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/btn_next_0"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/widget_nav_button"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&gt;" android:textColor="#1B5E20" android:textStyle="bold" android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- VIEW 1: ECO TIP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/widget_bg_round"
            android:padding="16dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ECO TIP"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#1B5E20" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="○ ● ○"
                    android:textSize="12sp"
                    android:textColor="#2E7D32" />
            </LinearLayout>
                
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            
            <TextView
                android:id="@+id/tv_eco_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Flatten boxes before recycling to save space in the bins."
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#2D5A2D"
                android:maxLines="3"
                android:ellipsize="end" />
                
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <LinearLayout
                    android:id="@+id/btn_prev_1"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/widget_nav_button"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&lt;" android:textColor="#1B5E20" android:textStyle="bold" android:textSize="16sp" />
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/btn_guides"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/widget_button_secondary"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EXPLORE GUIDES" android:textColor="#1B5E20" android:fontFamily="sans-serif-black" android:textSize="13sp" />
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/btn_next_1"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/widget_nav_button"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&gt;" android:textColor="#1B5E20" android:textStyle="bold" android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        
        <!-- VIEW 2: RECENT SCAN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/widget_bg_round"
            android:padding="16dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RECENT SCANS"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#1B5E20" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="○ ○ ●"
                    android:textSize="12sp"
                    android:textColor="#2E7D32" />
            </LinearLayout>
                
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <!-- Recent 0 -->
                <LinearLayout
                    android:id="@+id/view_recent_scan_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/widget_card_bg"
                    android:padding="12dp"
                    android:layout_marginRight="8dp">
                    <TextView
                        android:id="@+id/tv_recent_0_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#1B5E20"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/tv_recent_0_cat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#2E7D32"
                        android:layout_marginTop="2dp"
                        android:singleLine="true" />
                </LinearLayout>
                
                <!-- Recent 1 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/widget_card_bg"
                    android:padding="12dp"
                    android:layout_marginLeft="8dp">
                    <TextView
                        android:id="@+id/tv_recent_1_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#1B5E20"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/tv_recent_1_cat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#2E7D32"
                        android:layout_marginTop="2dp"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>
                
            <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                
                <LinearLayout
                    android:id="@+id/btn_prev_2"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/widget_nav_button"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&lt;" android:textColor="#1B5E20" android:textStyle="bold" android:textSize="16sp" />
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/btn_scan3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/widget_button_primary"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+ SCAN" android:textColor="#FFFFFF" android:fontFamily="sans-serif-black" android:textSize="14sp" />
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/btn_history2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/widget_button_secondary"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FULL LIST" android:textColor="#1B5E20" android:fontFamily="sans-serif-black" android:textSize="12sp" />
                </LinearLayout>
                
                <LinearLayout
                    android:id="@+id/btn_next_2"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/widget_nav_button"
                    android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&gt;" android:textColor="#1B5E20" android:textStyle="bold" android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </ViewFlipper>
</FrameLayout>
